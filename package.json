{
  "name": "photo-lab",
  "version": "0.1.0",
  "private": true,
  "description": "自用修圖工具（類 Lightroom）：Electron + WebGL2，支援 JPEG/PNG 與相機 RAW",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win",
    "build:web": "node scripts/build-web.mjs",
    "deploy:web": "node scripts/build-web.mjs && node scripts/deploy-web.mjs"
  },
  "dependencies": {
    "libraw-wasm": "1.6.0"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.badbadted.photolab",
    "productName": "Photo Lab",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "afterPack": "build/after-pack.cjs",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Photo Lab",
      "artifactName": "PhotoLab-安裝版-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PhotoLab-免安裝-${version}.${ext}"
    }
  }
}
